PORT=4000

# Payment provider configuration. Use provider-issued values at runtime; never commit real credentials.
MOLLIE_API_KEY=test_example
GPAY_PUBLIC_BASE_URL=https://pay.example.com

# Optional integrations retained by the wider GPAY application.
INFURA_PROJECT_ID=your_infura_project_id
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_STORE_DOMAIN=your_store.myshopify.com

# Optional GPAY evidence authenticity signing.
# This Ed25519 key signs evidenceHash values only. It is NOT a blockchain wallet/signing key.
# Supply the real private key only through the runtime secret manager/environment.
GPAY_EVIDENCE_SIGNING_KEY_ID=evidence-key-prod-1
# GPAY_EVIDENCE_ED25519_PRIVATE_KEY_PEM=<runtime-secret-only>

# GCOIN settlement on the investor-grade hardening branch is INTENT-ONLY.
# No blockchain private key is required or supported for GPAY->GCOIN settlement execution here.
